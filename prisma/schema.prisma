generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  phone     String? @default("")
  email     String  @unique
  password  String
  firstName String? @default("")
  lastName  String? @default("")

  profileImage          String?     @default("")
  expirationOtp         DateTime?   @default(now())
  fcmToken              String?     @default("")
  location              String?     @default("")
  gender                String?     @default("")
  lat                   Float?      @default(0)
  lng                   Float?      @default(0)
  otp                   Int?        @default(0)
  role                  UserRole    @default(User)
  isNotificationOn      Boolean     @default(false)
  isAvailable           Boolean     @default(true)
  status                UserStatus  @default(ACTIVE)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  otpExpiresAt          DateTime?   @default(now())
  service               String?     @default("")
  address               String?     @default("")
  serviceDayTotal       Int?        @default(0)
  serviceAvailableDates DateTime[]  @default([])
  serviceType           ServiceType @default(NOSERVICE)

  Service String? @default("")

  // Sitter specific fields
  perDayFee     Float?         @default(0)
  totalRating   Float?         @default(0)
  totalReviews  Int?           @default(0)
  experience    String?        @default("")
  about         String?        @default("")
  services      Service[]
  sitterProfile SitterProfile?

  SenderRooms   Room[] @relation("SenderRooms")
  ReceiverRooms Room[] @relation("ReceiverRooms")
  SentChats     Chat[] @relation("SentChats")
  ReceivedChats Chat[] @relation("ReceivedChats")

  // Relations
  notifications   Notification[]
  Dog             Dog[]
  ratingsGiven    Rating[]       @relation("RatingsGiven")
  ratingsReceived Rating[]       @relation("RatingsReceived")

  // Requests the user has made as a client
  clientRequests ClientRequest[] @relation("ClientRequestsAsClient")

  // Requests the user has received as a sitter
  sitterRequests ClientRequest[] @relation("ClientRequestsAsSitter")

  @@map("users")
}

model SitterProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  bio            String?  @default("")
  experience     String?  @default("")
  education      String?  @default("")
  certifications String[] @default([])
  languages      String[] @default([])
  availability   String?  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sitter_profiles")
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?  @default("")
  price       Float
  userId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Dog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  name        String?  @default("")
  gender      String?  @default("")
  age         String?  @default("")
  breed       String?  @default("")
  weight      String?  @default("")
  vaccination String?  @default("")
  spayed      String?  @default("")
  about       String?  @default("")
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ClientRequest ClientRequest[] @relation("RequestedDog")

  @@map("dogs")
}

model ClientRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // The person requesting the service
  client   User   @relation("ClientRequestsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @db.ObjectId

  dog      Dog    @relation("RequestedDog", fields: [dogId], references: [id], onDelete: Cascade)
  dogId    String @db.ObjectId

  // The sitter who is receiving the request
  sitter   User   @relation("ClientRequestsAsSitter", fields: [sitterId], references: [id], onDelete: Cascade)
  sitterId String @db.ObjectId

  startTime   DateTime
  endTime     DateTime
  serviceType ServiceType
  hourlyRate  Float
  totalPrice  Float
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Rating {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  rating             Float
  review             String?  @default("")
  ratingsGivenId     String   @db.ObjectId // User who gave the rating
  ratingsReceivedId  String   @db.ObjectId // Sitter who received the rating
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  ratingsGiven       User @relation("RatingsGiven", fields: [ratingsGivenId], references: [id], onDelete: Cascade)
  ratingsReceived    User @relation("RatingsReceived", fields: [ratingsReceivedId], references: [id], onDelete: Cascade)

  @@unique([ratingsGivenId, ratingsReceivedId])
  @@map("ratings")
}


model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  data      String?
  targetId  String?          @default("")
  slug      String?          @default("")
  fcmToken  String?          @default("")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Chat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  roomId     String   @db.ObjectId
  images     String[] @default([])

  isRead Boolean @default(false)

  sender   User @relation("SentChats", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedChats", fields: [receiverId], references: [id], onDelete: Cascade)
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String @db.ObjectId
  receiverId String @db.ObjectId
  sender     User   @relation("SenderRooms", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User   @relation("ReceiverRooms", fields: [receiverId], references: [id], onDelete: Cascade)
  chats      Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  User
  Sitter
  Admin
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum NotificationType {
  GENERAL
  REMINDER
  BOOKING
  PAYMENT
}

enum ServiceType {
  NOSERVICE
  DOGCARE
  BOARDING
  WALKING
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DENIED
  COMPLETED
}
