generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  phone     String? @default("")
  email     String  @unique
  password  String
  firstName String? @default("")
  lastName  String? @default("")

  profileImage          String?     @default("")
  expirationOtp         DateTime?   @default(now())
  fcmToken              String?     @default("")
  location              String?     @default("")
  gender                String?     @default("")
  lat                   Float?      @default(0)
  lng                   Float?      @default(0)
  otp                   Int?        @default(0)
  role                  UserRole    @default(User)
  isNotificationOn      Boolean     @default(false)
  isAvailable           Boolean     @default(true)
  status                UserStatus  @default(ACTIVE)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  otpExpiresAt          DateTime?   @default(now())
  address               String?     @default("")
  serviceDayTotal       Int?        @default(0)
  serviceAvailableDates DateTime[]  @default([])
  serviceType           ServiceType @default(NOSERVICE)

  stripeCustomerId String? @default("")

  // Sitter specific fields
  perDayFee     Float?         @default(0)
  totalRating   Float?         @default(0)
  totalReviews  Int?           @default(0)
  experience    String?        @default("")
  about         String?        @default("")

  sitterProfile SitterProfile?

  SenderRooms   Room[] @relation("SenderRooms")
  ReceiverRooms Room[] @relation("ReceiverRooms")
  SentChats     Chat[] @relation("SentChats")
  ReceivedChats Chat[] @relation("ReceivedChats")

  // Relations

  Dog             Dog[]
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  // Requests the user has made as a client
  clientRequests ClientRequest[] @relation("ClientRequestsAsClient")
  senderPayment  Payment[] @relation("SenderPayment")

  // Requests the user has received as a sitter
  sitterRequests        ClientRequest[] @relation("ClientRequestsAsSitter")
  RatingsPetReceived    PetRating[]     @relation("RatingsPetReceived")
  RatingsPetGiven       PetRating[]     @relation("RatingsPetGiven")
  sentNotifications     Notification[]  @relation("SentNotifications")
  receivedNotifications Notification[]  @relation("ReceivedNotifications")
  savedCards            SavedCard[]

  // Services
  serviceId       String?  @db.ObjectId
  services Service? @relation("UserSelectedService", fields: [serviceId], references: [id],  onDelete: NoAction, onUpdate: NoAction)

  // Services he provides
  servicesProvided Service[] @relation("ServiceProviderID")

  @@map("users")
}

model SitterProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  bio            String?  @default("")
  experience     String?  @default("")
  education      String?  @default("")
  certifications String[] @default([])
  languages      String[] @default([])
  availability   String?  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sitter_profiles")
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?  @default("")
  hourlyRate       Float
  // userId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  serviceType ServiceType 

  // Relations
  // Provider relation
  ServiceProviderID String @db.ObjectId
  ServiceProvider User @relation("ServiceProviderID",fields: [ServiceProviderID], references: [id], onDelete: Cascade)


  // Reverse relation
  selectedBy User[] @relation("UserSelectedService")

  @@map("services")
}

model Dog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  name        String?  @default("")
  gender      String?  @default("")
  age         String?  @default("")
  breed       String?  @default("")
  weight      String?  @default("")
  vaccination String?  @default("")
  spayed      String?  @default("")
  about       String?  @default("")
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  ClientRequest ClientRequest[] @relation("RequestedDog")
  
  //   requestId String[] @db.ObjectId
  //  clientRequest   ClientRequest[]    @relation("RequestedDog", fields: [requestId], references: [id])

  @@map("dogs")
}

model ClientRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // The person requesting the service
  client   User   @relation("ClientRequestsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @db.ObjectId

  dog   Dog    @relation("RequestedDog", fields: [dogId], references: [id], onDelete: Cascade)
  dogId String @db.ObjectId

  //   dog   Dog[]    @relation("RequestedDog", fields: [dogId], references: [id])
  // dogId String[] @db.ObjectId

  dogs  Json[]  @default([])
  // The sitter who is receiving the request
  sitter   User   @relation("ClientRequestsAsSitter", fields: [sitterId], references: [id], onDelete: Cascade)
  sitterId String @db.ObjectId

  startTime     DateTime
  endTime       DateTime
  serviceType   ServiceType
  hourlyRate    Float
  totalPrice    Float
  status        RequestStatus  @default(PENDING)
  paymentStatus PaymenttStatus @default(PENDING)
  Payment       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rating {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  rating            Float
  review            String?  @default("")
  ratingsGivenId    String   @db.ObjectId // User who gave the rating
  ratingsReceivedId String   @db.ObjectId // Sitter who received the rating
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  ratingsGiven    User @relation("RatingsGiven", fields: [ratingsGivenId], references: [id], onDelete: Cascade)
  ratingsReceived User @relation("RatingsReceived", fields: [ratingsReceivedId], references: [id], onDelete: Cascade)

  @@unique([ratingsGivenId, ratingsReceivedId])
  @@map("ratings")
}

model PetRating {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  rating            Float
  review            String?  @default("")
  ratingsGivenId    String   @db.ObjectId // User who gave the rating
  ratingsReceivedId String   @db.ObjectId // Sitter who received the rating
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  ratingsPetGiven    User @relation("RatingsPetGiven", fields: [ratingsGivenId], references: [id], onDelete: Cascade)
  ratingsPetReceived User @relation("RatingsPetReceived", fields: [ratingsReceivedId], references: [id], onDelete: Cascade)

  @@unique([ratingsGivenId, ratingsReceivedId])
  @@map("petRatings")
}

model Notification {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String           @db.ObjectId
  receiverId String           @db.ObjectId
  title      String
  body       String
  type       NotificationType @default(GENERAL)
  data       String?
  slug       String?          @default("")
  fcmToken   String?          @default("")
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Chat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  roomId     String   @db.ObjectId
  images     String[] @default([])

  isRead Boolean @default(false)

  sender   User @relation("SentChats", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedChats", fields: [receiverId], references: [id], onDelete: Cascade)
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String @db.ObjectId
  receiverId String @db.ObjectId
  sender     User   @relation("SenderRooms", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User   @relation("ReceiverRooms", fields: [receiverId], references: [id], onDelete: Cascade)
  chats      Chat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Link to the request being paid for
  requestId String        @db.ObjectId
  request   ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId String @db.ObjectId
  sender User @relation("SenderPayment", fields: [senderId], references: [id], onDelete: Cascade)

  amount        Float
  currency      String         @default("USD") // You can change default to your currency
  method        PaymentMethod  @default(CARD)
  methodCardId  String
  paymentStatus PaymenttStatus @default(PENDING)

  transactionId String?   @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SavedCard {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @db.ObjectId
  cardType              String
  last4                 String
  expiryMonth           Int
  expiryYear            Int
  isDefault             Boolean  @default(false)
  stripePaymentMethodId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_cards")
}

enum UserRole {
  User
  Sitter
  Admin
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum NotificationType {
  GENERAL
  REMINDER
  BOOKING
  PAYMENT
}

enum ServiceType {
  NOSERVICE
  DOGCARE
  BOARDING
  WALKING
}

enum RequestStatus {
  PENDING
  ACCEPTED
  ONGOING
  DENIED
  COMPLETED
}

enum PaymenttStatus {
  PENDING
  ACCEPTED
  DENIED
  FAILED
  REFUNDED
  COMPLETED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}
